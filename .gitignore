# Python / Conda
.venv/
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/

# Alembic
alembic/versions/*.pyc

# Environment
.env
*.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Docker
postgres_data/

# Frontend (for later)
node_modules/
frontend/dist/
frontend/.vite/
frontend/.env.local

# Claude Code / tooling — local session state and scratch only.
# CLAUDE.md is deliberately NOT here: it documents the dev environment, the
# architecture split, and the solver conventions, so it belongs in the repo.
.claude/
.playwright-mcp/
.verify/

# Packaged Helm charts (regenerate with helm package)
charts/*.tgz

# Deployment values files — these hold real secrets (auth.secretKey, DB and
# MCP service passwords). Never commit one.
roster.yaml
*-values.yaml
values-*.yaml

# Terraform (infra/aws and infra/aws/registry). State files hold real secrets (DB password, JWT key)
# and .terraform/ is the downloaded provider cache. The .terraform.lock.hcl
# file IS committed: it pins provider checksums, like package-lock.json.
infra/aws/**/.terraform/
infra/aws/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
