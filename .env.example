POSTGRES_USER=roster
POSTGRES_PASSWORD=changeme
POSTGRES_DB=roster_engine
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API key for the in-app chat assistant (backend/app/chat/). Get one at
# https://console.anthropic.com/settings/keys
#
# Deliberately namespaced: Compose resolves ${VAR} from the shell environment
# before this file, so naming it ANTHROPIC_API_KEY would let a shell that exports
# that name (common on dev machines) silently override whatever you set here. The
# backend container still receives it as ANTHROPIC_API_KEY.
ROSTER_ANTHROPIC_API_KEY=

# Service account the MCP server uses to authenticate to the backend on the agent's
# behalf. Injected into the mcp container only — never into the agent's container.
ROSTER_SERVICE_USERNAME=svc-mcp
ROSTER_SERVICE_PASSWORD=password