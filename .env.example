POSTGRES_USER=roster
POSTGRES_PASSWORD=changeme
POSTGRES_DB=roster_engine
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Service account the MCP server uses to authenticate to the backend on the agent's
# behalf. Injected into the mcp container only — never into the agent's container.
ROSTER_SERVICE_USERNAME=svc-mcp
ROSTER_SERVICE_PASSWORD=password

# Bearer token every MCP client must send to the MCP server
# (`Authorization: Bearer <this>`). Without it, anyone who can reach port 8001
# acts as the service account above. Generate with: openssl rand -hex 32
MCP_ACCESS_TOKEN=

# ── Chat assistant ───────────────────────────────────────────────────────────
# The assistant is served by the AgentOps platform: this app holds only an
# Application Key (issued on the AgentOps Applications page) and the id of the
# "Roster Planner" agent. No model-provider key lives here. AgentOps picks the
# model, runs the roster tools through this app's MCP server, applies guardrails
# and records the run, cost and audit trail.
CHAT_PROVIDER=agentops
AGENTOPS_BASE_URL=http://agentops-bff:8080
AGENTOPS_CLIENT_ID=
AGENTOPS_CLIENT_SECRET=
AGENTOPS_AGENT_ID=
AGENTOPS_MODEL=

# ── Break-glass: direct model access, bypassing AgentOps ─────────────────────
# Only for when the platform is unavailable. CHAT_PROVIDER=anthropic (Claude API,
# needs ROSTER_ANTHROPIC_API_KEY and egress) or CHAT_PROVIDER=openai (any
# OpenAI-compatible endpoint, needs CHAT_BASE_URL + CHAT_MODEL) is refused unless
# CHAT_DIRECT_ENABLED=true as well, and the backend logs a warning while it is
# on. `scripts/chat-provider.sh anthropic` sets both; `scripts/chat-provider.sh
# agentops` switches back.
CHAT_DIRECT_ENABLED=false
# Deliberately namespaced: Compose resolves ${VAR} from the shell environment
# before this file, so naming it ANTHROPIC_API_KEY would let a shell that exports
# that name (common on dev machines) silently override whatever you set here. The
# backend container still receives it as ANTHROPIC_API_KEY.
ROSTER_ANTHROPIC_API_KEY=
